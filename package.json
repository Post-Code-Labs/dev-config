{
  "name": "@post-code-labs/dev-config",
  "version": "0.0.0",
  "description": "Shared, importable baseline configs (Prettier, tsconfig, ESLint, ruff/mypy) for consuming repos. Released as CalVer git tags (YYYY.MM); the tag is the version contract, not this field.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.mjs' && pnpm test:markdown",
    "test:markdown": "markdownlint-cli2 --config markdown/base.jsonc test/fixtures/valid.md && markdownlint-cli2 --config test/fixtures/max-lines-rules.markdownlint-cli2.jsonc AGENTS.md README.md markdown/README.md",
    "test:python": "ruff check --config python/ruff.toml test/fixtures/python && ruff format --config python/ruff.toml --check test/fixtures/python && mypy --config-file python/mypy.ini test/fixtures/python && sqlfluff lint --config python/.sqlfluff test/fixtures/sql"
  },
  "exports": {
    "./prettier": "./prettier/index.json",
    "./typescript/tsconfig.base.json": "./typescript/tsconfig.base.json",
    "./typescript/tsconfig.node.json": "./typescript/tsconfig.node.json",
    "./typescript/tsconfig.react.json": "./typescript/tsconfig.react.json",
    "./eslint/base": "./eslint/base.mjs",
    "./eslint/react": "./eslint/react.mjs",
    "./python/ruff.toml": "./python/ruff.toml",
    "./python/mypy.ini": "./python/mypy.ini",
    "./python/.sqlfluff": "./python/.sqlfluff",
    "./markdown/base.jsonc": "./markdown/base.jsonc",
    "./markdown/rules/create-max-lines-rule": "./markdown/rules/create-max-lines-rule.mjs",
    "./markdown/rules/agents-max-lines": "./markdown/rules/agents-max-lines.mjs",
    "./markdown/rules/readme-max-lines": "./markdown/rules/readme-max-lines.mjs",
    "./versions.json": "./versions.json",
    "./dependency-policy.yml": "./dependency-policy.yml"
  },
  "files": [
    "prettier",
    "typescript",
    "eslint",
    "python",
    "markdown",
    "versions.json",
    "dependency-policy.yml"
  ],
  "peerDependencies": {
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "peerDependenciesMeta": {
    "eslint-config-next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "eslint": "10.8.0",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "markdownlint-cli2": "0.23.2",
    "next": "16.2.12",
    "prettier": "3.9.6",
    "react": "^19.0.0",
    "react-dom": "19.2.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
